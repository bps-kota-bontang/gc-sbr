# Matcha Pro Ground Check Configuration
# Copy file ini ke .env dan isi dengan nilai yang sesuai

# API Credentials (Update secara berkala ketika expired)
# Cara mendapatkan:
# 1. Buka https://matchapro.web.bps.go.id/dirgc di browser
# 2. Login ke sistem
# 3. Buka Developer Tools (F12) → Network tab
# 4. Lakukan POST request ke endpoint data-gc-card
# 5. Copy seluruh cookie dari Request Headers
# 6. Copy nilai dari XSRF-TOKEN (sudah di-decode) atau _token dari form data

COOKIE=your_cookie_here
TOKEN=your_token_here
INITIAL_GC_TOKEN=your_initial_gc_token_here

# Konfigurasi Lokasi
ID_PROVINSI=id_provinsi_matcha_pro
ID_KABUPATEN=id_kabupaten_matcha_pro
CITY=nama_kabupaten_kota